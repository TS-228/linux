
/ {
	/include/ "rtd119x/rtd-119x-usb.dtsi"

	rtk_usb_power_manager@0 {
		compatible = "Realtek,usb-manager";
		realtek,port0-power-gpio = <&rtk_misc_gpio 5 1 0>; /*usb3 power , output, default low */

		status = "okay";
	};

	dwc3: rtk_dwc3@18013200 {
		status = "okay";

		dwc3@18020000 {
			dr_mode = "host";
			/*
			 * The vendor's original TX/RX threshold + auto-retry
			 * workaround (see dwc3_rtk_tx_rx_thr_quirk() in
			 * drivers/usb/dwc3/core.c) is available via
			 * "snps,rtk-tx-rx-thr-quirk" but left disabled here:
			 * 12 iterations of parallel checksum-verified writes
			 * to both SATA-bridge drives (sda+sdb, ~1.15GB total)
			 * against mainline's dwc3 driver produced zero
			 * transaction errors or port resets. Re-add the
			 * property if that ever changes.
			 */
		};
	};

	ehci@18013000 {
		compatible = "Realtek,rtd119x-ehci";

		status = "okay";
	};

	ohci@18013400 {
		compatible = "Realtek,rtd119x-ohci";

		status = "okay";
	};
};
