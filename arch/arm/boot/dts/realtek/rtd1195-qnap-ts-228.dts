/*
 *
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include "../../../mach-rtd119x/include/mach/memory.h"

/memreserve/ 0x00000000				SYS_BOOTCODE_MEMSIZE;				/* ROM code */
/memreserve/ PLAT_NOR_PHYS			PLAT_NOR_SIZE;						/* NOR */
/memreserve/ ACPU_FIREWARE_PHYS 	ACPU_FIREWARE_SIZE;					/* Audio Firmware */
/memreserve/ RPC_RINGBUF_PHYS 		RPC_RINGBUF_SIZE;					/* RPC ring buffer */

#include "rtd119x/rtd-119x.dtsi"
#include "rtd119x/rtd-1195-usb.dtsi"

/ {
	model= "Realtek_CA7_CA7";
	compatible = "Realtek,FPGA_v6", "Realtek,rtd-119x";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
	};

	chosen {
		/*
		 * Provide earlycon + extras only. Do not repeat console=ttyS0 here:
		 * U-Boot already passes console=, and CONFIG_CMDLINE_EXTEND would
		 * otherwise register the console twice (doubled printk output).
		 *
		 * USB rescue: PARTUUID=f04240a9-02 (GPT on sdc). eMMC is mmcblk1
		 * (MBR); native eMMC root needs the rtkemmc module in initramfs
		 * and root=/dev/mmcblk1p2 (see linux-3.10 CONFIG_CMDLINE).
		 */
		bootargs = "earlycon=uart8250,mmio32,0x18007800 loglevel=4 quiet clk_ignore_unused root=PARTUUID=f04240a9-02 init=/usr/sbin/init rootwait rw";
		stdout-path = "serial0:115200n8";
		linux,initrd-start = <0x02200000>;
		linux,initrd-end = <0x02600000>;
	};

	memory {
		device_type = "memory";
		reg =  <0x00000000 0x40000000>;					/* 1024 MB */
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		rbus@0 {
			compatible = "rsvmem-remap";
			save_remap_name = "rbus";
			reg = <RBUS_BASE_PHYS RBUS_BASE_SIZE>;
			rtk_rbus_barrier_flag;
		};

		common@0 {
			compatible = "rsvmem-remap";
			save_remap_name = "common";
			reg = <RPC_COMM_PHYS RPC_COMM_SIZE>;
		};

		ringbuf@0 {
			compatible = "rsvmem-remap";
			save_remap_name = "ringbuf";
			reg = <RPC_RINGBUF_PHYS RPC_RINGBUF_SIZE>;
		};
	};

	timer0@1801b000 {
		clock-frequency = <27000000>;
	};
	timer1@1801b000 {
		clock-frequency = <27000000>;
	};
	uart0: serial0@18007800 {
		clock-frequency = <27000000>;
		/*
		 * Stock 8250_dw overwrites clock-frequency with clk_get_rate()
		 * when a clocks phandle is present. The UR0 gate reports 0, so
		 * probe fails with -EINVAL. Drop clocks and rely on the fixed
		 * rate; U-Boot leaves UR0 on and cmdline has clk_ignore_unused.
		 */
		/delete-property/ clocks;
	};
	uart1: serial1@1801B200 {
		clock-frequency = <432000000>;
		/delete-property/ clocks;
	};

	/*
	 * Vendor quirk: early USB mass-storage unbind + msleep(10000) before
	 * rebind (rtk-usb-manager). That delays root-on-USB by ~10s. Not needed
	 * for openSUSE on a stick; leave shared rtd-119x-usb.dtsi alone.
	 */
	rtk_usb_power_manager@0 {
		/delete-property/ en_usb_storage_reprobe;
	};

	/* I2C3 carries the Epson RX-8010 RTC, as on the vendor kernel. */
	i2c@1801B900 {
		status = "okay";

		rtc@32 {
			compatible = "epson,rx8010";
			reg = <0x32>;
		};
	};

	rtk_misc_gpio: rtk_misc_gpio@1801b100 {
		gpios =
		<&rtk_misc_gpio 4 0 0>, 				/*install button, input, default N/A */
	//	<&rtk_misc_gpio 5 1 1>, 				/*usb3 power , output, default high */
		<&rtk_misc_gpio 8 1 1>; 				/*audio dac unmute , output, default high */
	};

	/*
	 * Front-panel GPIO from stock model_QX421_12.conf (GPIO:I2x → misc hex pin):
	 *   USB_COPY_BUTTON = GPIO:I2C:P → misc 44 (0x2c)
	 *   RESET_BUTTON    = GPIO:I2D:P → misc 45 (0x2d)
	 *   disk1 ERR_LED   = GPIO:I2E:P → misc 46 (0x2e)
	 *   disk2 ERR_LED   = GPIO:I2F:P → misc 47 (0x2f)
	 *
	 * Realtek gpio cells are <pin dir default>; input <pin 0 1> = active-low.
	 * Disk bay LEDs are bi-color on one GPIO: stock HAL :P inverts so ERR on
	 * drives the line low (red); deasserted/high shows green. No PRESENT_LED
	 * in the model file. Encode as <pin 1 2> (active-low out, idle high).
	 * Buzzer is on the PIC (opcodes 0x50/0x51), not a SoC GPIO.
	 */
	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		usb-copy {
			label = "usb-copy";
			linux,code = <KEY_COPY>;
			gpios = <&rtk_misc_gpio 44 0 1>;
			debounce-interval = <50>;
		};

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&rtk_misc_gpio 45 0 1>;
			debounce-interval = <50>;
		};
	};

	gpio_leds: gpio-leds {
		compatible = "gpio-leds";

		/* on = red (error); off = green (OK). Same physical LED. */
		disk1_err {
			label = "red:disk1";
			gpios = <&rtk_misc_gpio 46 1 2>;
			default-state = "off";
		};

		disk2_err {
			label = "red:disk2";
			gpios = <&rtk_misc_gpio 47 1 2>;
			default-state = "off";
		};
	};

	nic: gmac@18016000 {
		rtl-features = <2>;
		/*
		 * MAC comes from the PIC EEPROM via the qnap-ts228-pic NVMEM
		 * provider.
		 */
		nvmem-cells = <&mac_cell>;
		nvmem-cell-names = "mac-address";
		status = "okay";
	};
	usb_ss: rtk_dwc3@18013200 {
		realtek,rst-gpio = <&rtk_misc_gpio 5 1 0>;		/*usb3 power , output, default low */
		dwc3@18020000 {
			dr_mode = "host";
		};
	};
	suspend@18007400 {
		compatible = "Realtek,suspend";
		realtek,wifi-gpio = <&rtk_iso_gpio 13 1 1>;		/*wifi power , output, default high */

	};
	bt_wakeup_host@0{
		compatible = "Realtek,bt_wakeup_host";
		realtek,bt-wakeup-gpio = <&rtk_iso_gpio 2 0 0>;	/* bt wakeup host pin, input, default N/A */
		activity_level = "high";						/* "high": high active, "low": low active */
		status = "disabled";							/* "okay"/"disabled" */
	};

	crsd@18010400 {
		gpios = <&rtk_misc_gpio 23 1 1>; 		/*sd power , output, default high  (poweroff) */
	};

	sb2@1801a000 {
		status = "okay";
	};
};

&uart1 {
	status = "okay";

	/* QNAP TS-228 front-panel PIC (fan, temperature) on UART1 */
	pic {
		compatible = "qnap,ts228-pic";
		#address-cells = <1>;
		#size-cells = <1>;

		fan_0: fan-0 {
			cooling-levels = <0 64 128 192 255>;
			#cooling-cells = <2>;
		};

		/*
		 * PIC EEPROM MAC is stored as 6 bytes (binary) in this NVMEM
		 * provider's logical address space.
		 */
		mac_cell: mac-address@0 {
			reg = <0x0 0x6>;
		};
	};
};

&cpu_thermal {
	trips {
		/* Start ramping the system fan before the SoC gets hot. */
		fan_on: fan-on {
			temperature = <55000>;
			hysteresis = <3000>;
			type = "passive";
		};
	};
	cooling-maps {
		fan_map0 {
			trip = <&fan_on>;
			cooling-device = <&fan_0 0 4>;
			contribution = <1024>;
		};
	};
};

/*
 * The shared rtd-119x.dtsi leaves i2c_pins_3 unmuxed; the vendor TS-X28 DTB
 * muxes it, which is what puts the RX-8010 on the wire. The whole list has to
 * be restated because a DT property is replaced wholesale, not merged.
 *
 * Fan is controlled by the QNAP MCU on UART1, not the SoC PWM block.
 */
&pinctrl {
	pinctrl-0 = <&ir_rx_pins>, <&ir_tx_pins>,
		<&i2c_pins_0>, <&i2c_pins_1>, <&i2c_pins_3>,
		<&i2c_pins_5>, <&i2c_pins_6>,
		<&sdio_pins>, <&uart1_pins_loc_iso>,
		<&vfd_pins>, <&mmc_pins>;
};
